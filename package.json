{
  "name": "trustbut",
  "version": "0.7.0",
  "description": "Verifiable receipts for code written by AI coding agents",
  "keywords": [
    "agent-receipts",
    "ai-agents",
    "claude-code",
    "codex",
    "cursor",
    "gemini-cli",
    "opencode",
    "code-review",
    "testing",
    "verification",
    "vitest",
    "pytest",
    "cli"
  ],
  "author": "Almog Koren (https://almog.io)",
  "homepage": "https://github.com/isAlmogK/trustbut#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/isAlmogK/trustbut.git"
  },
  "bugs": {
    "url": "https://github.com/isAlmogK/trustbut/issues"
  },
  "type": "module",
  "bin": {
    "trustbut": "dist/cli.js"
  },
  "files": [
    "dist",
    "spec",
    "integrations/claude-code/scripts/run.mjs"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "Apache-2.0",
  "scripts": {
    "build": "tsup src/cli.ts --format esm --target node22 --clean",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "receipt": "npm run build && node dist/cli.js verify",
    "prepare": "npm run build",
    "release:bump": "node scripts/release/bump.mjs",
    "check:versions": "node scripts/release/check-versions.mjs",
    "check:plugin-version": "vitest run test/plugin.test.ts -t \"plugin.json matches package.json\""
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "commander": "^15.0.0",
    "execa": "^10.1.0",
    "fast-xml-parser": "^5.11.2",
    "parse-diff": "^0.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "jest": "^30.5.2",
    "mocha": "^12.0.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
